{
  "name": "rcm-doctor",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts && tsx scripts/eval-evidence.ts",
    "gen:demo": "tsx scripts/generate-demo-rcm.ts",
    "precompute": "tsx scripts/precompute-demo.ts",
    "record:demo": "tsx scripts/record-demo.ts",
    "typecheck": "tsc --noEmit",
    "gen:holdout": "tsx scripts/generate-holdout.ts",
    "review:holdout": "tsx scripts/precompute-demo.ts --input data/holdout/holdout-rcm.xlsx --out data/holdout/holdout-results.json",
    "eval:holdout": "tsx scripts/eval.ts --set holdout",
    "precompute:testscripts": "tsx scripts/precompute-testscripts.ts",
    "mcp": "tsx mcp/server.ts",
    "build:mcp": "esbuild mcp/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=mcp/dist/rcm-doctor-mcp.mjs --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\" --minify --legal-comments=none --log-level=warning && chmod +x mcp/dist/rcm-doctor-mcp.mjs",
    "record:mcp": "tsx scripts/record-mcp-session.ts",
    "gen:evidence": "tsx scripts/generate-evidence.ts",
    "precompute:evidence": "tsx scripts/precompute-evidence.ts",
    "eval:evidence": "tsx scripts/eval-evidence.ts",
    "og": "tsx scripts/make-og.ts",
    "record:lifecycle": "tsx scripts/record-lifecycle.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "Open-source AI reviewer for Risk & Control Matrices (internal controls / IKS).",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "rcm-doctor-mcp": "mcp/dist/rcm-doctor-mcp.mjs"
  }
}
