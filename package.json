{
  "name": "rcm-doctor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "gen:demo": "tsx scripts/generate-demo-rcm.ts",
    "precompute": "tsx scripts/precompute-demo.ts",
    "record:demo": "tsx scripts/record-demo.ts",
    "typecheck": "tsc --noEmit",
    "gen:holdout": "tsx scripts/generate-holdout.ts",
    "review:holdout": "tsx scripts/precompute-demo.ts --input data/holdout/holdout-rcm.xlsx --out data/holdout/holdout-results.json",
    "eval:holdout": "tsx scripts/eval.ts --set holdout",
    "eval:holdout2": "tsx scripts/eval.ts --set holdout2 && tsx scripts/eval.ts --set holdout2-baseline",
    "review:holdout2": "tsx scripts/precompute-demo.ts --input data/holdout-v2/holdout-rcm.xlsx --out data/holdout-v2/holdout-results.json --concurrency 1",
    "precompute:testscripts": "tsx scripts/precompute-testscripts.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "Open-source AI reviewer for Risk & Control Matrices (internal controls / IKS).",
  "license": "Apache-2.0",
  "type": "module"
}
